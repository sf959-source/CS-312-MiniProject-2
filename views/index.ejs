<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Generate random riddle </title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Generate random riddle</h1>

  <p>Click the button below to get a random riddle.</p>

  <a href="/riddle">Get a Riddle</a>

<% if (error) { %>
  <p><%= error %></p>
<% } %>

<% if (riddle) { %>
  <div class="riddle-box">
    <h2>Riddle:</h2>
    <p><%= riddle.riddle %></p>

    <h3>Answer:</h3>
    <p><%= riddle.answer %></p>
  </div>
<% } %>

</body>
</html>